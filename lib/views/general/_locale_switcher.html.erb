<nav id="user_locale_switcher" class="locale-list" aria-label="<%= _('Language') %>">
  <% if @locales[:available].any? %>
    <button type="button"
            class="locale-list-trigger <%= @locales[:current] %>"
            aria-expanded="false"
            aria-controls="available-languages">
      <span class="visually-hidden"><%= _('Language') %></span>
      <strong class="current-locale"><%= locale_name(@locales[:current]) %></strong>
    </button>

    <ul id="available-languages" class="available-languages">
      <% @locales[:available].each do |locale| %>
        <li class="available-languages__item">
          <%= link_to locale_name(locale), current_path_with_locale(locale) %>
        </li>
      <% end %>
    </ul>
  <% end %>
</nav>
