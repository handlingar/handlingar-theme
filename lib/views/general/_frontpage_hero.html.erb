<div class="homepage-hero" id="main-content" tabindex="-1">
  <div class="row">
    <div class="hero__headline">
      <h1 class="hero__title"><%= _("We help you get in touch with public authorities") %></h1>
      <p class="hero__subtitle"><%= _("for your right to know") %></p>
    </div>

    <p class="hero__browse">
      <%= _("Browse <a href=\"{{requests_url}}\">" \
            "{{number_of_requests}} requests</a> to " \
            "<a href=\"{{authorities_url}}\">" \
            "{{number_of_authorities}} authorities</a>",
          :requests_url => request_list_successful_path,
          :number_of_requests => number_with_delimiter(@number_of_requests),
          :authorities_url => list_public_bodies_default_path,
          :number_of_authorities => number_with_delimiter(@number_of_authorities)) %>
    </p>

    <div class="hero__ctas">
      <%= link_to _("Make a request"), select_authority_path, class: "link_button_green" %>
      <%= link_to _("Learn more about us"), help_about_path, class: "button-secondary" %>
    </div>
  </div>
</div>

<%# 1.5 USP section — three Unique Selling Propositions on the dark surface %>
<div class="homepage-usp ds-dark">
  <div class="row">
    <ul class="usp__list">
      <li class="usp__item">
        <%= ds_icon('antenna-signal', html_class: 'ds-icon usp__icon') %>
        <h2 class="usp__title"><%= _("Streamline your work") %></h2>
        <p class="usp__text"><%= _("Send the same freedom-of-information request to several authorities at once and free up more time for journalism.") %></p>
        <%= link_to _("Read more"), account_request_index_path, class: "usp__link button-tertiary" %>
      </li>
      <li class="usp__item">
        <%= ds_icon('mail-open', html_class: 'ds-icon usp__icon') %>
        <h2 class="usp__title"><%= _("Up-to-date details") %></h2>
        <p class="usp__text"><%= _("You have access to contact details for thousands of organisations covered by the principle of public access.") %></p>
        <%= link_to _("Read more"), list_public_bodies_default_path, class: "usp__link button-tertiary" %>
      </li>
      <li class="usp__item">
        <%= ds_icon('lock', html_class: 'ds-icon usp__icon') %>
        <h2 class="usp__title"><%= _("Private requests") %></h2>
        <p class="usp__text"><%= _("Keep your requests private while you work on your project. You decide when you are ready to make them public.") %></p>
        <%= link_to _("Read more"), account_request_index_path, class: "usp__link button-tertiary" %>
      </li>
    </ul>
  </div>
</div>
