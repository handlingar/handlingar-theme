<div class="footer" id="footer" role="contentinfo">
  <div class="row footer__top">
    <div class="footer__about">
      <h2><%= site_name %></h2>
      <p class="footer__run-by">
        <%= _("Run by Open Knowledge Sweden with the Alaveteli software.") %>
      </p>
      <p class="footer__publisher">
        <%= _("Responsible publisher: Elenor Weijmar") %>
      </p>

      <div class="final__social-links footer__social">
        <ul>
          <% unless AlaveteliConfiguration::facebook_username.blank? %>
            <li>
              <%= link_to "https://facebook.com/#{AlaveteliConfiguration::facebook_username}",
                          class: 'social-link social-link--facebook' do %>
                <%= ds_icon('facebook', html_class: 'ds-icon ds-icon--social') %>
                <span>/<%= AlaveteliConfiguration::facebook_username %></span>
              <% end %>
            </li>
          <% end %>
          <% unless AlaveteliConfiguration::twitter_username.blank? %>
            <li>
              <%= link_to "https://twitter.com/#{AlaveteliConfiguration::twitter_username}",
                          class: 'social-link social-link--twitter' do %>
                <%= ds_icon('x', html_class: 'ds-icon ds-icon--social') %>
                <span>@<%= AlaveteliConfiguration::twitter_username %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <nav class="footer__nav" aria-label="<%= _('Footer') %>">
      <ul class="footer__links">
        <li><%= link_to _('Contact us'), help_contact_path %></li>
        <li><%= link_to _('Privacy and cookies'), help_privacy_path %></li>
      </ul>
      <ul class="footer__links">
        <% if feature_enabled?(:pro_pricing) %>
          <li><%= link_to _('{{pro_site_name}} Terms', pro_site_name: pro_site_name), pro_page_path(:id => 'legal') %></li>
        <% end %>
        <li><%= link_to _('API'), help_api_path %></li>
      </ul>
      <ul class="footer__links">
        <li><%= link_to _('Help'), help_path %></li>
      </ul>
    </nav>
  </div>
</div>
