<dl class="pricing__faqs__list">
  <dt class="faqs__term"><%= _('How do I cancel my account?') %></dt>
  <dd class="faqs__def">
    <%= _('Contact us and we will help you cancel. The Pro terms explain how the subscription works.') %>
    <%= link_to _('Pro terms'), pro_page_path('legal') %>.
  </dd>

  <dt class="faqs__term"><%= _('What does my subscription fee go towards?') %></dt>
  <dd class="faqs__def">
    <%= _('Handlingar Pro is run by Digital Openers AB. Your fee supports the Pro tools and the running of Handlingar.se.') %>
  </dd>

  <dt class="faqs__term"><%= _('How do I change my payment details?') %></dt>
  <dd class="faqs__def">
    <%= _('Contact us and we will help you update your payment details.') %>
    <%= link_to _('Contact us'), help_contact_path %>.
  </dd>

  <dt class="faqs__term"><%= _('I’ve got a voucher code') %></dt>
  <dd class="faqs__def">
    <%= _('Enter the code at checkout, or contact us if you need help redeeming it.') %>
  </dd>
</dl>
