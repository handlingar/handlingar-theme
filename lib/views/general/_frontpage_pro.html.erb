<% authority_count = number_with_delimiter(PublicBody.visible.count) %>
<% pro_usps = [
  { icon: 'antenna-signal', title: _("Streamline your work"), text: _("Send the same public-records request to several authorities at once and get more time for journalism.") },
  { icon: 'mail-open', title: _("Up-to-date details"), text: _("You have access to contact details for {{count}} organisations covered by the principle of public access.", :count => authority_count) },
  { icon: 'lock', title: _("Private requests"), text: _("Keep case requests private while you work on your project. You choose when you are ready to make them public.") }
] %>

<%# 3.1 Handlingar.se PRO marketing section (design booklet page 30) %>
<div class="homepage-pro">
  <div class="row">
    <div class="pro__intro">
      <div class="pro__intro-text">
        <h2 class="pro__title"><%= _("The premium service for journalists, researchers, associations and entrepreneurs") %></h2>
        <p class="pro__lead"><%= _("Handlingar PRO is a powerful toolbox with everything you need when working with information and public records.") %></p>
        <p class="pro__lead pro__lead--secondary"><%= _("Handlingar.se is a free service, run entirely on a non-profit basis, helping you get the information you need by making a request for public records from responsible authorities, regions, municipalities and organisations.") %></p>
        <%= link_to _("Get premium"), account_request_index_path, class: "link_button_green" %>
      </div>
      <div class="pro__intro-illustration" aria-hidden="true">
        <%= image_tag "illustrations/undraw_sign-up.svg", alt: "" %>
      </div>
    </div>

    <ul class="pro__usp-grid">
      <% 2.times do %>
        <% pro_usps.each do |usp| %>
          <li class="pro__usp">
            <%= ds_icon(usp[:icon], html_class: 'ds-icon usp__icon') %>
            <h3 class="usp__title"><%= usp[:title] %></h3>
            <p class="usp__text"><%= usp[:text] %></p>
          </li>
        <% end %>
      <% end %>
    </ul>

    <div class="pro__media">
      <h2 class="pro__media-title"><%= _("Handlingar.se in the media and news") %></h2>
      <ul class="pro__media-logos">
        <li class="pro__media-logo pro__media-logo--altinget">Altinget</li>
        <li class="pro__media-logo pro__media-logo--journalisten">Journalisten</li>
        <li class="pro__media-logo pro__media-logo--tranquillity">Tranquillity</li>
      </ul>
    </div>
  </div>
</div>
