<% request_current = controller?('request') && action?('new', 'select_authority') %>
<% bodies_current = controller?('public_body') %>
<% blog_current = controller?('general') && action?('blog') %>
<% help_current = controller?('help') %>

<li class="<%= 'selected' if request_current %>">
  <%= link_to _("Make a request"), select_authority_path, :id => 'make-request-link', :aria => { :current => ('page' if request_current) } %>
</li>

<li class="<%= 'selected' if bodies_current %>">
  <%= link_to _("View authorities"), list_public_bodies_default_path, :aria => { :current => ('page' if bodies_current) } %>
</li>

<% if feature_enabled?(:alaveteli_pro) %>
  <li class="<%= 'selected' if @in_pro_area %>">
    <%= link_to _("Pro"), account_request_index_path %>
  </li>
<% end %>

<li>
  <%= link_to _("Services"), 'https://about.handlingar.se/' %>
</li>

<% if Blog.enabled? %>
  <li class="<%= 'selected' if blog_current %>"><%= link_to _("Read blog"), blog_path, :aria => { :current => ('page' if blog_current) } %></li>
<% end %>

<li class="<%= 'selected' if help_current %>">
  <%= link_to _("Help"), help_about_path, :aria => { :current => ('page' if help_current) } %>
</li>
